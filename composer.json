{
    "name": "luizjr/repositories",
    "description": "Flexible Laravel Repository Library. Credit: SebastianBerc",
    "keywords": [
        "league",
        "repository"
    ],
    "homepage": "https://github.com/SebastianBerc/Repositories",
    "license": "MIT",
    "authors": [
        {
            "name": "William Mandai",
            "email": "wm@gitbench.com",
            "homepage": "https://workice.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4|^8.5",
        "illuminate/contracts": "^11.0",
        "illuminate/database": "^11.0",
        "illuminate/support": "^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "SebastianBerc\\Repositories\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SebastianBerc\\Repositories\\Test\\": "tests"
        },
        "classmap": [
            "tests/migrations"
        ]
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    }
}
